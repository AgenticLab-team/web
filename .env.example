# 这个文件是**模板**，只有键名和说明，没有任何真实值。
# 复制成 .env.local 再往里填：`cp .env.example .env.local`
# .env* 全部在 .gitignore 里 —— 真实值永远不进仓库。

# ── 上游 NekoBot API ────────────────────────────────────────
# 微信群的消息、成员、机器人发信都来自这里。这个站本身不连微信。
# 部署时它通常经隧道反代到本机端口，所以下面填的是 127.0.0.1。
# 本地开发要连远端的话，自己用 ssh -N -L 8090:127.0.0.1:8090 <你的服务器> 打通，
# 主机地址不写在仓库里（见 .gitignore 的 .deploy-host）。
NEKOBOT_BASE_URL=http://127.0.0.1:8090/v1
NEKOBOT_API_KEY=
NEKOBOT_TIMEOUT_MS=20000

DB_PATH=./data/agenticlab.db

SITE_URL=http://localhost:3000
SITE_NAME=Agentic Lab

# WebAuthn 的 rpId 必须与实际访问域名一致，否则 Passkey 校验必失败
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Agentic Lab
WEBAUTHN_ORIGIN=http://localhost:3000

# ── Web Push（不配就只有站内通知，不会报错）──────────────────
# 生成：npm run webpush-keys
# subject 要求是 mailto: 或 https:，推送服务出问题时他们照这个联系你。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── GitHub 绑定（不配就整个功能不出现：入口不渲染、路由 404）──
# 在 https://github.com/settings/developers 建一个 OAuth App：
#   Homepage URL          = 你的 SITE_URL
#   Authorization callback = <SITE_URL>/api/auth/github/callback
#
# 申请的 scope 是**空的** —— 只读公开信息，碰不到私有仓库，也发不了东西。
#
# 三项缺一不可。半套配置比没配置更糟：按钮会照常出现、点下去走到一半
# 才在 GitHub 那边失败，而用户会以为是自己的 GitHub 有问题。
#
# GITHUB_TOKEN_KEY 用来加密存下来的 access token，必须是 32 字节的十六进制串：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 换掉它等于让所有已存的 token 作废（功能降级，不会崩），所以它要跟着备份走。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN_KEY=

# 只读 token，用来给资源库里的 GitHub 链接问出「这是什么仓库」。
# 和上面三项**互相独立**：不配也能跑，绑定功能也不受影响。
#
# 它是**配额，不是权限**。不带 token 时 GitHub 按**服务器 IP** 每小时
# 只给 60 次，而我们全站共用一个出口 IP —— 资源库两百多条链接一轮就撞墙。
# 带上之后是每小时 5000 次。
#
# 在 https://github.com/settings/tokens 建一个，**一个 scope 都不要勾**。
# 勾了 repo 的话私有仓库会开始有响应 —— 于是别人贴一条私有仓库链接，
# 我们会替他把标题和简介展开给所有人看。这是这个变量唯一真正危险的地方。
GITHUB_API_TOKEN=

# ── 存储与备份 ──────────────────────────────────────────────
BACKUP_DIR=./data/backups
# 冷层裁剪时正文归档到这里。这些文件是那些正文的**唯一**副本
ARCHIVE_DIR=./data/archive

# ── 异地备份（不配就没有异地副本，磁盘挂了备份跟着一起没）─────
# 任何 S3 协议的对象存储都行：Cloudflare R2、Backblaze B2、MinIO。
# 每天几 MB，基本落在免费额度里。
# 四项缺一不可 —— 半套配置比没配置更糟，它会让任务真的跑起来、真的失败，
# 然后失败被当成偶发问题忽略掉。
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
# R2 要求 region 填 auto；S3 填真实区域
OFFSITE_S3_REGION=auto
OFFSITE_S3_PREFIX=agenticlab/

# ── 图床（不配也能用，但会撞上访客限流）─────────────────────
# 上传走 files.mrusercontent.com。它的访客通道是**按 IP** 限流的
# （10 分钟 20 次），而我们是从服务器代传的 —— 全站共用一个出口 IP。
# 也就是说不配 key 的话，**全站每 10 分钟只能发 20 张图**。
# 本地开发无所谓，线上必须配：在 files.mrusercontent.com 登录之后，
# 它的 /agent-prompt 会内嵌一个 key。
UPLOAD_API_KEY=

# ── 大模型与嵌入（不配则语义检索和自动摘要不可用，其余功能照常）──
# 两套分开配是因为它们经常不是同一家：实测 DeepSeek 只有对话、没有嵌入。
# 换嵌入模型之后，语义检索那条相似度门槛要重新量一遍 ——
# 不同模型的分布完全不同，照搬会让门槛要么形同虚设、要么把真结果全挡掉。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 换模型时这个数要跟着改，否则已存的向量和新向量维度对不上、检索直接失效
EMBEDDING_DIMENSIONS=1024

# ── 收信网关（不配的话收信入口整个关闭，返回 503）──────────────
# SMTP 网关收到信之后，把它 POST 到 /api/mail/inbound，并用这个密钥
# 对**整个请求体**做 HMAC-SHA256 签名，放在 X-Mail-Signature 头里。
#
# 为什么是签名而不是一把 Bearer 令牌：这个接口接受的是**任意发件人
# 送来的内容**，而那些内容会直接落进用户的收件箱。令牌只证明调用方
# 知道一个秘密，签名还证明**这一份内容**没有在中途被换掉。
#
# 不配时接口直接关门（503），而不是放行 —— 放行的话，任何人都能往
# 任意地址投递任意内容，而它看起来完全正常在工作。这是那种
# 「配置漏了一半比没配更糟」的地方。
#
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 两边（网关和这里）必须一模一样。
MAIL_INGRESS_SECRET=

# ── 高质量消息的判定门槛 ────────────────────────────────────
# 榜单主排序用的是「高质量消息数」而不是总条数 ——
# 按总条数排会让复读机上榜。不配走代码里的默认值。
NEKOBOT_QUALITY_MIN=
