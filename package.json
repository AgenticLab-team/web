{
  "name": "agenticlab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bootstrap": "tsx --conditions=react-server --env-file=.env.local scripts/bootstrap.ts",
    "sync": "tsx --conditions=react-server --env-file=.env.local scripts/sync.ts",
    "groups": "tsx --conditions=react-server --env-file=.env.local scripts/groups.ts",
    "db:generate": "drizzle-kit generate",
    "resync": "tsx --conditions=react-server --env-file=.env.local scripts/resync.ts",
    "verify": "tsx --conditions=react-server --env-file=.env.local scripts/verify.ts",
    "calibrate": "tsx --conditions=react-server --env-file=.env.local scripts/calibrate.ts",
    "grant": "tsx --conditions=react-server --env-file=.env.local scripts/grant.ts",
    "whois": "tsx --conditions=react-server --env-file=.env.local scripts/whois.ts",
    "backfill-interactions": "tsx --conditions=react-server --env-file=.env.local scripts/backfill-interactions.ts",
    "backup": "tsx --conditions=react-server --env-file=.env.local scripts/backup.ts",
    "health": "tsx --conditions=react-server --env-file=.env.local scripts/health.ts",
    "prune": "tsx --conditions=react-server --env-file=.env.local scripts/prune.ts",
    "offsite": "tsx --conditions=react-server --env-file=.env.local scripts/offsite.ts",
    "links": "tsx --conditions=react-server --env-file=.env.local scripts/links.ts",
    "digest": "tsx --conditions=react-server --env-file=.env.local scripts/digest.ts",
    "recount-boards": "tsx --conditions=react-server --env-file=.env.local scripts/recount-boards.ts",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "webpush-keys": "tsx scripts/webpush-keys.ts",
    "deploy": "bash scripts/deploy.sh",
    "grant-title": "tsx --conditions=react-server --env-file=.env.local scripts/grant-title.ts",
    "enrich-links": "tsx --conditions=react-server scripts/enrich-links.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "isomorphic-dompurify": "^3.22.0",
    "lucide-react": "^1.30.0",
    "marked": "^18.0.9",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shiki": "^4.4.2",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
