# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# 线上是蓝绿两份构建产物（见 next.config.ts 的 distDir），
# 而且临时排查时也常见 .next-xxx 这种目录 —— 一律不进仓库。
# 只写 /.next/ 的话它们全都是「未跟踪」，迟早被一次 git add -A 带进去。
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本地数据库与备份
/data/
*.db
*.db-shm
*.db-wal

# agent worktrees —— 它们各自是独立的 git 仓库，不该进主仓
.claude/worktrees/
