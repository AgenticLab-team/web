[Unit]
# 蓝。和 agenticlab-green.service 是同一个应用的两份，端口和构建目录不同。
#
# 为什么要两份：见 scripts/deploy.sh 顶上那段。一句话 ——
# 在线上直接构建会把正在跑的进程脚下的 .next 换掉，而重启又有几秒空窗。
# 两份轮流上，nginx 平滑切过去，两个窗口一起消失。
#
# 两份**共用同一个代码目录和同一个数据库**，只有 NEXT_DIST_DIR 和 PORT 不同。
# 不做成两棵目录树是故意的：那样 data/、.env.local、几个定时任务
# 都要跟着分身，而它们本来就该只有一份。
Description=Agentic Lab community site (blue :3000)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/agenticlab
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_DIST_DIR=.next-blue
ExecStart=/usr/local/bin/node node_modules/next/dist/bin/next start
Restart=always
RestartSec=3

# 下面这两行是「停一个实例」这件事的全部难点。

# `next start` 收到 SIGTERM 之后**以 143 退出**（128+15，Node 的惯例）。
# systemd 默认把非零退出码当失败 —— 于是每一次正常的蓝绿切换之后，
# 被停掉的那一边都留下一个 `failed` 单元。
#
# 那个 failed 不影响服务，但它是**误导性状态**：以后真出事时，
# 看 `systemctl list-units` 的人会先被这个假失败带走十分钟。
SuccessExitStatus=143

# 默认 90 秒。有 SSE 长连接挂着时，优雅停止会一直等到超时再 SIGKILL ——
# 那既让部署慢 90 秒，又把单元标成 `failed (timeout)`。
#
# 应用侧已经在收到信号时主动断开所有 SSE（见 instrumentation.ts），
# 这里的 20 秒是兜底：万一还有什么东西不肯松手，
# 也不该让一次部署卡在那儿。
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

# 只需要读写自己的目录
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# 两个构建目录都要给：部署时会由另一边来建这一边的产物。
#
# 前面那个减号是「不存在就跳过」。**没有它这个单元根本起不来**：
# 第一次装的时候 .next-green 还不存在，而 systemd 建挂载命名空间时
# 遇到列出来却不存在的路径会直接判启动失败 ——
# 症状是一个和构建、和代码都无关的 226/NAMESPACE，很难往这上面想。
ReadWritePaths=-/home/ubuntu/agenticlab/data -/home/ubuntu/agenticlab/.next-blue -/home/ubuntu/agenticlab/.next-green

[Install]
WantedBy=multi-user.target
