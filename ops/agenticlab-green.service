[Unit]
# 绿。和 agenticlab-blue.service 只差 PORT 和 NEXT_DIST_DIR 两行。
#
# 两个文件写死、不用 systemd 的模板单元（agenticlab@.service），是因为
# 半夜出事的时候，`cat` 一下就能看全的东西，比一个要在脑子里
# 展开 %i 的模板有用。
Description=Agentic Lab community site (green :3001)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/agenticlab
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_DIST_DIR=.next-green
ExecStart=/usr/local/bin/node node_modules/next/dist/bin/next start
Restart=always
RestartSec=3

# 下面这两行是「停一个实例」这件事的全部难点。

# `next start` 收到 SIGTERM 之后**以 143 退出**（128+15，Node 的惯例）。
# systemd 默认把非零退出码当失败 —— 于是每一次正常的蓝绿切换之后，
# 被停掉的那一边都留下一个 `failed` 单元。
#
# 那个 failed 不影响服务，但它是**误导性状态**：以后真出事时，
# 看 `systemctl list-units` 的人会先被这个假失败带走十分钟。
SuccessExitStatus=143

# 默认 90 秒。有 SSE 长连接挂着时，优雅停止会一直等到超时再 SIGKILL ——
# 那既让部署慢 90 秒，又把单元标成 `failed (timeout)`。
#
# 应用侧已经在收到信号时主动断开所有 SSE（见 instrumentation.ts），
# 这里的 20 秒是兜底：万一还有什么东西不肯松手，
# 也不该让一次部署卡在那儿。
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# 减号 = 不存在就跳过。见 blue 那个文件里的说明 ——
# 少了它，第一次启动会挂在 226/NAMESPACE 上
ReadWritePaths=-/home/ubuntu/agenticlab/data -/home/ubuntu/agenticlab/.next-blue -/home/ubuntu/agenticlab/.next-green

[Install]
WantedBy=multi-user.target
